# Supabase — client-safe (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only (NEVER expose to the client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Observability — where unhandled errors are pushed for alerting (server-only).
# Any URL that accepts a JSON POST: a Slack/Discord incoming webhook, a Better
# Stack / Axiom ingest endpoint. Unset = log-only, no alerting.
OBSERVABILITY_ALERT_URL=

# Institution timezone for all displayed dates. Defaults to Asia/Dhaka.
NEXT_PUBLIC_INSTITUTION_TZ=Asia/Dhaka

# Feature flags — OTP sign-in is hidden until an SMS provider is contracted.
NEXT_PUBLIC_OTP_ENABLED=false
